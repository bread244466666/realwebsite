# Used by Cloudflare Pages and Netlify (other hosts ignore this file).
# Files in /assets have a hash in their name and never change, so browsers may keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=86400
# "no-transform" tells Cloudflare not to rewrite this page. That stops it from injecting its own
# Web Analytics script (beacon.min.js), which Lighthouse reports as Legacy JavaScript, a long request
# chain and a short cache lifetime. Remove the word "no-transform" if you want Cloudflare Web Analytics.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
